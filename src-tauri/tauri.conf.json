{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OctoDock",
  "version": "0.1.0",
  "identifier": "com.octodock.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OctoDock",
        "width": 1200,
        "height": 800,
        "minWidth": 500,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["default", "desktop-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
